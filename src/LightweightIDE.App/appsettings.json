{
  "Ui": {
    "Theme": "system",
    "ShowMemoryUsage": true
  },
  "Editor": {
    "TabSize": 4,
    "InsertSpaces": true,
    "FontFamily": "Monospace",
    "FontSize": 11,
    "ShowWhitespace": false,
    "WrapLines": false,
    "LargeFileThresholdKb": 2048,
    "SemanticHighlighting": true,
    "InlayHints": true,
    "HighlightUsages": true,
    "FadeUnusedCode": true
  },
  "Language": {
    "LoadWorkspaceOnOpen": true,
    "DiagnosticsDelayMs": 600,
    "Configuration": "Debug",
    "MaxReferences": 5000
  },
  "Formatting": {
    "Engine": "Auto",
    "FormatOnSave": false,
    "FormatOnType": true
  },
  "Indexing": {
    "MaxContentFileSizeKb": 1024,
    "WatcherDebounceMs": 400
  },
  "Serilog": {
    "MinimumLevel": "Information"
  }
}
